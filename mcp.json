{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "workmagic": {
      "type": "streamable-http",
      "url": "https://mcp.workmagic.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationUrl": "https://platform.workmagic.io/api/oauth2/authorize",
            "tokenUrl": "https://platform.workmagic.io/api/oauth2/token",
            "registrationUrl": "https://platform.workmagic.io/api/connect/register",
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    }
  }
}
